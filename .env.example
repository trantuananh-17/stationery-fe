# Base URL cua BFF — cong HTTP public DUY NHAT cua backend.
# Local: http://localhost:3400/api/v1
SERVER_API=http://localhost:3400/api/v1
NEXT_PUBLIC_SERVER_API=http://localhost:3400/api/v1

# Hai service duoi day FE goi THANG, khong qua BFF (xem .claude/rules/known-issues.md muc B).
# ai-service: 3413 · upload-service: 3408
NEXT_PUBLIC_SERVER_AI_API=http://localhost:3413/api/v1
NEXT_PUBLIC_SERVER_UPLOAD_API=http://localhost:3408/api/v1

# WebSocket cua notification-service (gateway gan vao HTTP server cua service).
NEXT_PUBLIC_SOCKET_URL=http://localhost:3406

# Base URL cua chinh FE — dung cho Stripe return_url.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phai khop han that cua JWT do auth-service phat hanh
# (apps/auth-service/.../token.service.ts: accessToken '1d', refreshToken '7d').
NEXT_PUBLIC_ACCESS_TOKEN_EXPIRES=86400
NEXT_PUBLIC_REFRESH_TOKEN_EXPIRES=604800

# Stripe publishable key (pk_test_... khi dev). Lay o https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
